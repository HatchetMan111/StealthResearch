[Unit]
Description=StealthScraper-LXC API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scraper
WorkingDirectory=/opt/stealth-scraper
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/stealth-scraper/pw-browsers
ExecStart=/opt/stealth-scraper/venv/bin/uvicorn app.server:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
